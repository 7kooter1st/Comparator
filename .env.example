# Путь к tesseract.exe (Windows), если не в PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Языки OCR (rus+eng для русского и английского)
TESSERACT_LANG=rus+eng

# Максимальный размер загружаемого файла в МБ
MAX_FILE_SIZE_MB=25

# Масштаб рендеринга PDF страниц перед OCR (чем выше — тем точнее, но медленнее)
PDF_RENDER_ZOOM=2.0

# Язык PaddleOCR (ru, en, ch и др.)
PADDLEOCR_LANG=ru

# Путь для моделей PaddleOCR (обязательно ASCII, без кириллицы!)
PADDLEOCR_HOME=C:/paddleocr_cache
