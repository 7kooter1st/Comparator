# Путь к tesseract.exe (Windows), если не в PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Язык OCR: только rus — меньше путаницы кириллица/латиница (не используйте rus+eng для русских документов)
TESSERACT_LANG=rus

# Linux: sudo apt install tesseract-ocr-rus
# Либо скачайте rus.traineddata в папку tessdata/ проекта (см. README)
# TESSDATA_PREFIX=/custom/path/to/tesseract/

# Режим сегментации страницы: 3 — авто, 6 — единый блок текста (лучше для договоров)
TESSERACT_PSM=6

# Движок: 1 — только LSTM (рекомендуется для rus)
TESSERACT_OEM=1

# Максимальный размер загружаемого файла в МБ
MAX_FILE_SIZE_MB=25

# Масштаб рендеринга PDF перед OCR (2.5–3.0 для мелкого шрифта)
PDF_RENDER_ZOOM=3.0

# Язык PaddleOCR
PADDLEOCR_LANG=ru

# Поворот текста: false для ровных PDF из Word, true для сканов под углом
PADDLEOCR_USE_ANGLE_CLS=false

# GPU для PaddleOCR: auto | true | false (нужен paddlepaddle-gpu и CUDA)
PADDLEOCR_USE_GPU=auto

# Режим OCR по умолчанию: fast | accurate
DEFAULT_OCR_MODE=accurate

# Zoom для режимов (fast — быстрее, accurate — точнее)
PDF_RENDER_ZOOM_FAST=2.0
PDF_RENDER_ZOOM_ACCURATE=3.0

# Параллельная обработка страниц Tesseract (Paddle на GPU — последовательно)
OCR_PAGE_WORKERS=4

# Путь для моделей PaddleOCR (обязательно ASCII, без кириллицы!)
PADDLEOCR_HOME=C:/paddleocr_cache

# Подробная статистика сравнения (доп. вызовы compare_documents)
# DEBUG=false

# Собранный Vite-фронтенд (по умолчанию: dist/ в корне проекта)
# FRONTEND_DIST=/path/to/dist
